# Normalize text files to LF in the repo and working tree on all platforms.
# Without this, Windows core.autocrlf=true fights Wails-generated bindings
# (frontend/wailsjs) and shows phantom "modified" diffs with no content change.
* text=auto eol=lf

# Wails build cache — local only, regenerated by wails dev/build.
frontend/package.json.md5 -text

# Generated bindings; always LF, marked for GitHub linguist.
frontend/wailsjs/** linguist-generated

# Windows packaging/scripts that require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
